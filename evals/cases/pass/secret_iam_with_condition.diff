diff --git a/modules/security_base/secret_iam.tf b/modules/security_base/secret_iam.tf
new file mode 100644
index 0000000..a1b2c3d
--- /dev/null
+++ b/modules/security_base/secret_iam.tf
@@ -0,0 +1,16 @@
+# Secret Manager へのアクセスは prd- プレフィックスの IAM Condition を必須とする
+# （.clinerules §4 多層防御: prd-/infra- プレフィックスによるスコープ限定）
+resource "google_secret_manager_secret_iam_member" "app_accessor" {
+  project   = var.project_id
+  secret_id = google_secret_manager_secret.app.secret_id
+  role      = "roles/secretmanager.secretAccessor"
+  member    = "serviceAccount:${var.app_sa_email}"
+
+  condition {
+    title       = "prd-prefix-only"
+    description = "prd- プレフィックスのシークレットのみ参照を許可"
+    expression  = "resource.name.startsWith(\"projects/${var.project_number}/secrets/prd-\")"
+  }
+}
