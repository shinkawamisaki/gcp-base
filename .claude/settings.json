{
  "permissions": {
    "deny": [
      "Bash(terraform *destroy*)",
      "Bash(rm -rf *.terraform*)",
      "Bash(gcloud * delete)",
      "Bash(gcloud * delete *)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main*)",
      "Bash(git push * master)",
      "Bash(git push * master *)",
      "Bash(git push *:master*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [{"type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/verify_stop_hook.sh\""}]
      }
    ]
  }
}
