#!/bin/bash
set -e

echo "============================================================"
echo "[INFO] Running pre-commit hook: scripts/cross_verify.sh"
echo "============================================================"

# cross_verify.sh を実行
./scripts/cross_verify.sh

EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
  echo "============================================================"
  echo "[ERROR] Commit rejected due to cross_verify.sh failure."
  echo "============================================================"
  exit 1
fi

echo "[SUCCESS] Cross-verification passed. Proceeding with commit."
exit 0
